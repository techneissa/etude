# etude_embed_melodies(DIR OUTPUT): writes OUTPUT, a C++ source holding DIR/manifest.txt and every
# file its "file | NAME.mid | ..." lines name, as byte arrays, with
#   std::span<const unsigned char> etude::app::embedded_melody_manifest();
#   std::span<const unsigned char> etude::app::embedded_melody_file(std::string_view name);
# (empty for a name the manifest does not list). A file the manifest names that is missing stops the
# configure. Only rewrites OUTPUT on a change, so a reconfigure does not force a rebuild.
function(etude_embed_melodies dir output)
  file(STRINGS "${dir}/manifest.txt" lines REGEX "^file \\| ")
  set(arrays "")
  set(table "")
  set(index 0)
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "^file \\| ([^ ]+) \\|.*$" "\\1" name "${line}")
    if(NOT EXISTS "${dir}/${name}")
      message(FATAL_ERROR "manifest.txt lists ${name}, which is not in ${dir}")
    endif()
    file(READ "${dir}/${name}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
    string(APPEND arrays "const unsigned char kFile${index}[] = {\n${bytes}\n};\n")
    string(APPEND table "    {\"${name}\", kFile${index}, sizeof(kFile${index})},\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dir}/${name}")
    math(EXPR index "${index} + 1")
  endforeach()
  file(READ "${dir}/manifest.txt" manifest_hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," manifest_bytes "${manifest_hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" manifest_bytes "${manifest_bytes}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dir}/manifest.txt")
  set(content "// Generated by cmake/EmbedMelodies.cmake from ${dir}. Do not edit.
#include <cstddef>
#include <span>
#include <string_view>

namespace etude::app {
namespace {
const unsigned char kManifest[] = {
${manifest_bytes}
};
${arrays}
struct Entry {
    const char* name;
    const unsigned char* data;
    std::size_t size;
};
const Entry kFiles[] = {
${table}};
} // namespace

std::span<const unsigned char> embedded_melody_manifest() { return {kManifest, sizeof(kManifest)}; }

std::span<const unsigned char> embedded_melody_file(std::string_view name) {
    for (const Entry& e : kFiles) {
        if (name == e.name) {
            return {e.data, e.size};
        }
    }
    return {};
}

} // namespace etude::app
")
  if(EXISTS "${output}")
    file(READ "${output}" previous)
    if(previous STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${output}" "${content}")
endfunction()
