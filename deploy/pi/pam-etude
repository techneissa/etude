# PAM stack for etude.service and etude-labwc.service (PAMName=etude).
# Installed to /etc/pam.d/etude by deploy/pi/setup.sh. Gives the service a logind session.
# Adapted from the cage wiki. UNTESTED on a Pi.
auth     required pam_permit.so
account  required pam_permit.so
session  required pam_unix.so
session  required pam_env.so readenv=1 user_readenv=0
session  required pam_systemd.so
